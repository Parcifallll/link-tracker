# Tokens
APP_TELEGRAM_TOKEN=
GITHUB_TOKEN=
STACKOVERFLOW_KEY=
STACKOVERFLOW_ACCESS_KEY=

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=link-tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin

# Kafka
KAFKA_PORT=29092
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# Redis
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_REPLICA1_PORT=6380
VALKEY_REPLICA2_PORT=6381
VALKEY_SENTINEL1_PORT=26379
VALKEY_SENTINEL2_PORT=26380
VALKEY_SENTINEL3_PORT=26381

# Bot
BOT_SERVER_PORT=8081
BOT_GRPC_SERVER_PORT=9091
BOT_GRPC_ADDRESS=localhost:9091
TELEGRAM_DEBUG=false

# Scrapper
SCRAPPER_SERVER_PORT=8080
SCRAPPER_GRPC_SERVER_PORT=9090
SCRAPPER_GRPC_ADDRESS=localhost:9090
# decided by Resilience, kafka/grpc
NOTIFICATION_TYPE=kafka
DB_ACCESS_TYPE=ORM
SCHEDULER_INTERVAL=30s
SCHEDULER_BATCH_SIZE=100
CACHE_TTL=10m

SPRING_PROFILES_ACTIVE=dev
